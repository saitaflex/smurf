# Gravv (sandbox)
GRAVV_API_KEY=
GRAVV_PUBLIC_KEY=
GRAVV_ESCROW_ACCOUNT_ID=

# Supabase (real values live in .env / .env.local — never commit them here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (vision model for image deliverable verification)
GROQ_API_KEY=

# Vercel Sandbox / agent dispatch
AGENT_BROWSER_SNAPSHOT_ID=
AGENT_CALLBACK_SECRET=
CRON_SECRET=

# Planner LLM (Groq JSON-mode; overridable)
GROQ_PLANNER_MODEL=llama-3.3-70b-versatile

# Vercel Sandbox auth outside Vercel: `vercel link && vercel env pull`
# (VERCEL_OIDC_TOKEN) or an access token + ids:
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
SANDBOX_TIMEOUT_MS=600000

# Public URL the sandbox POSTs its verdict to. Leave empty on localhost —
# the orchestrator falls back to writing Supabase directly.
VERIFY_CALLBACK_URL=

# Python executable for the planner subprocess (default: python)
PYTHON_BIN=
